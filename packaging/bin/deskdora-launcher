#!/bin/sh
# DeskDora launcher (used by the applications-menu entry):
# start the local service if it is not already running, wait until it
# answers, then open the DeskDora application window.
#
# The default — and what the desktop entry runs — is the native GTK
# window (deskdora.window).  `--browser` exists only as a debugging
# fallback that opens the UI in the default browser instead; it is
# not the default anywhere.
URL="http://127.0.0.1:8765"

probe() {
  python3 - "$URL" <<'PYEOF' >/dev/null 2>&1
import sys, urllib.request
try:
    urllib.request.urlopen(sys.argv[1] + "/api/status", timeout=2)
except Exception:
    sys.exit(1)
PYEOF
}

if ! probe; then
  DATA="$HOME/.local/share/deskdora"
  mkdir -p "$DATA"
  nohup /usr/bin/deskdora serve >>"$DATA/server.log" 2>&1 &
  i=0
  while [ $i -lt 40 ]; do
    probe && break
    i=$((i + 1))
    sleep 0.5
  done
fi

if [ "${1:-}" = "--browser" ]; then
  xdg-open "$URL" >/dev/null 2>&1 &
  exit 0
fi

# Rendering guards for virtualised desktops: WebKitGTK's DMABUF
# renderer needs a GPU; without a DRI render node (VMs, Xvfb) ask for
# the software path.  Only set when unset, and never on a machine
# with a real GPU device — real desktops keep their defaults.
if [ ! -e /dev/dri/renderD128 ]; then
  : "${WEBKIT_DISABLE_DMABUF_RENDERER:=1}"
  export WEBKIT_DISABLE_DMABUF_RENDERER
  : "${LIBGL_ALWAYS_SOFTWARE:=1}"
  export LIBGL_ALWAYS_SOFTWARE
fi

exec /opt/deskdora/venv/bin/python -m deskdora.window "$URL"
