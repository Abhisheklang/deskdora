#!/bin/sh
# DeskDora post-removal: drop the postinst-created virtualenv (the only
# part of /opt/deskdora that dpkg does not own).  Per-user data under
# ~/.local/share/deskdora is deliberately left alone.
set -e

case "$1" in
  remove|purge)
    rm -rf /opt/deskdora/venv
    # Python bytecode caches are generated at run time, so dpkg does
    # not own them and would otherwise leave the tree behind.
    find /opt/deskdora -name __pycache__ -type d -exec rm -rf {} + \
      2>/dev/null || true
    find /opt/deskdora -depth -type d -empty -delete 2>/dev/null || true
    ;;
esac

exit 0
